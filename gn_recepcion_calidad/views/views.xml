<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_6189" model="ir.ui.view">
            <field name="name">template_view_Recepción</field>
            <field name="model">x_quality_check_worksheet_template_1</field>
            <field name="type">form</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><form create="false" js_class="worksheet_validation">
                <sheet>
                    <h1 invisible="context.get('studio') or context.get('default_x_quality_check_id')">
                        <field name="x_quality_check_id" domain="[('test_type', '=', 'worksheet')]"/>
                    </h1>
                    <group>
                        <group>
                            <field name="x_comments"/>
                            <field name="x_passed"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </sheet>
            </form></field>
        </record>

        <record id="view_6190" model="ir.ui.view">
            <field name="name">tree_view_Recepción</field>
            <field name="model">x_quality_check_worksheet_template_1</field>
            <field name="type">tree</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><tree>
                    <field name="create_date" widget="date"/>
                    <field name="x_name"/>
                </tree></field>
        </record>

        <record id="view_6191" model="ir.ui.view">
            <field name="name">search_view_Recepción</field>
            <field name="model">x_quality_check_worksheet_template_1</field>
            <field name="type">search</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><search>
                    <field name="x_name"/>
                    <filter string="Created on" date="create_date" name="create_date"/>
                    <filter name="group_by_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </search></field>
        </record>

        <record id="view_6193" model="ir.ui.view">
            <field name="name">Odoo Studio: template_view_Recepción customization</field>
            <field name="model">x_quality_check_worksheet_template_1</field>
            <field name="inherit_id" ref="view_6189"/>
            <field name="priority" eval="99"/>
            <field name="mode">extension</field>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><data>
  <xpath expr="//field[@name='x_comments']" position="before">
    <field name="x_studio_incidence_type" widget="many2many_tags" options="{&quot;no_create&quot;: true, &quot;color_field&quot;: &quot;color&quot;}" required="True"/>
    <field widget="image" name="x_studio_delivery_note" options="{&quot;size&quot;:[0,90]}" required="True"/>
  </xpath>
  <xpath expr="//field[@name='x_comments']" position="attributes">
    <attribute name="invisible">not set(x_studio_incidence_type).intersection([2, 3, 4, 1])</attribute>
    <attribute name="required">set(x_studio_incidence_type).intersection([2, 3, 4, 1])</attribute>
  </xpath>
  <xpath expr="//field[@name='x_comments']" position="after">
    <field widget="image" name="x_studio_missing_product_imagen" options="{&quot;size&quot;:[0,90]}" invisible="not set(x_studio_incidence_type).intersection([1])" required="set(x_studio_incidence_type).intersection([1])"/>
    <field widget="image" name="x_studio_wrong_product_imagen" options="{&quot;size&quot;:[0,90]}" invisible="not set(x_studio_incidence_type).intersection([2])" required="set(x_studio_incidence_type).intersection([2])"/>
    <field widget="image" name="x_studio_damaged_product_imagen" options="{&quot;size&quot;:[0,90]}" invisible="not set(x_studio_incidence_type).intersection([3])" required="set(x_studio_incidence_type).intersection([3])"/>
    <field widget="image" name="x_studio_wrong_quantity_imagen" options="{&quot;size&quot;:[0,90]}" invisible="not set(x_studio_incidence_type).intersection([4])" required="set(x_studio_incidence_type).intersection([4])"/>
    <field widget="image" name="x_studio_extra_pic_1" options="{&quot;size&quot;:[0,90]}" invisible="False" required="True"/>
    <field widget="image" name="x_studio_extra_pic_2" options="{&quot;size&quot;:[0,90]}" invisible="not set(x_studio_incidence_type).intersection([2, 3, 4, 1])"/>
  </xpath>
  <xpath expr="//field[@name='x_passed']" position="attributes">
    <attribute name="required">True</attribute>
  </xpath>
</data></field>
        </record>

        <!-- Vistas de la acción de ventana (después de crear las vistas) -->
        <record id="action_window_1726" model="ir.actions.act_window">
            <field name="search_view_id" ref="view_6191"/>
        </record>
</odoo>
