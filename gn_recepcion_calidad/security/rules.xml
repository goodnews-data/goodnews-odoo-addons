<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="rule_545" model="ir.rule">
            <field name="name">Recepciones solo del almacén asignado al usuario</field>
            <field name="model_id" ref="stock.model_stock_picking_type"/>
            <field name="domain_force">[
    '|',
    ('code', '=', 'internal'),
    ('warehouse_id.partner_id.user_ids', 'in', [user.id])
]




</field>
            <field name="groups" eval="[Command.set([ref('gn_studio_grupos.group_156'), ref('gn_studio_grupos.group_168')])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <record id="rule_546" model="ir.rule">
            <field name="name">x_quality_check_worksheet_template_1_own</field>
            <field name="model_id" ref="gn_recepcion_calidad_base.model_x_quality_check_worksheet_template_1"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[Command.set([ref('quality.group_quality_user')])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="active" eval="True"/>
        </record>

        <record id="rule_547" model="ir.rule">
            <field name="name">x_quality_check_worksheet_template_1_all</field>
            <field name="model_id" ref="gn_recepcion_calidad_base.model_x_quality_check_worksheet_template_1"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.set([ref('quality.group_quality_manager')])]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="active" eval="True"/>
        </record>
</odoo>
