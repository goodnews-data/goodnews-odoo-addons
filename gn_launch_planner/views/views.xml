<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Change (line) form: opened from the launch, shows only the
         inputs that make sense for the selected change
         ============================================================ -->
    <record id="view_launch_line_form" model="ir.ui.view">
        <field name="name">x_gn_launch_line.form</field>
        <field name="model">x_gn_launch_line</field>
        <field name="arch" type="xml">
            <form string="Cambio">
                <group>
                    <group>
                        <field name="x_operation"/>
                        <field name="x_mode"
                               invisible="x_operation not in ('pos_available', 'pos_categ', 'combos', 'pos_categories', 'pricelist_price')"
                               required="x_operation in ('pos_available', 'pos_categ', 'combos', 'pos_categories', 'pricelist_price')"/>
                    </group>
                    <group>
                        <field name="x_value_float"
                               invisible="x_operation not in ('list_price', 'standard_price', 'supplier_price') and not (x_operation == 'pricelist_price' and x_mode == 'set')"/>
                        <field name="x_allow_zero"
                               invisible="x_operation not in ('list_price', 'standard_price', 'supplier_price') and not (x_operation == 'pricelist_price' and x_mode == 'set')"/>
                        <field name="x_value_char" invisible="x_operation != 'name'" required="x_operation == 'name'"/>
                        <field name="x_lang_id" invisible="x_operation != 'name'" options="{'no_create': True}"/>
                        <field name="x_pos_categ_ids" widget="many2many_tags" options="{'no_create': True}"
                               invisible="x_operation not in ('pos_categ', 'pos_categories')"
                               required="x_operation in ('pos_categ', 'pos_categories')"/>
                        <field name="x_combo_ids" widget="many2many_tags" options="{'no_create': True}"
                               invisible="x_operation != 'combos'" required="x_operation == 'combos'"/>
                        <field name="x_pricelist_ids" widget="many2many_tags" options="{'no_create': True}"
                               domain="['|', ('company_id', '=', False), ('company_id', '=', parent.x_company_id)]"
                               invisible="x_operation != 'pricelist_price'" required="x_operation == 'pricelist_price'"/>
                        <field name="x_supplier_ids" widget="many2many_tags" options="{'no_create': True}"
                               invisible="x_operation != 'supplier_price'" required="x_operation == 'supplier_price'"/>
                    </group>
                </group>
                <div class="text-muted" invisible="x_operation != 'standard_price'">
                    El coste es por compañía: se cambia en la compañía del lanzamiento, en todas las variantes.
                </div>
                <div class="text-muted" invisible="x_operation != 'pricelist_price'">
                    «Poner precio» actualiza el precio fijo del producto en la tarifa o lo crea si no existe.
                    Solo toca precios fijos por producto sin fechas ni cantidad mínima.
                </div>
                <div class="text-muted" invisible="x_operation != 'pos_categories'">
                    Cambia qué categorías ven los puntos de venta del lanzamiento. La categoría de inicio de cada
                    punto de venta se mantiene siempre.
                </div>
                <div class="text-muted" invisible="x_operation != 'name'">
                    Sin idioma, el nombre cambia en todos los idiomas instalados.
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================
         Launch form
         ============================================================ -->
    <record id="view_launch_form" model="ir.ui.view">
        <field name="name">x_gn_launch.form</field>
        <field name="model">x_gn_launch</field>
        <field name="arch" type="xml">
            <form string="Lanzamiento">
                <header>
                    <button name="%(action_schedule)d" type="action" string="Programar" class="btn-primary"
                            invisible="x_state != 'draft'"/>
                    <button name="%(action_launch_now)d" type="action" string="Lanzar ya"
                            invisible="x_state not in ('draft', 'scheduled', 'error')"
                            confirm="Se aplicará ahora mismo (en el próximo minuto), sin esperar a la fecha. ¿Seguimos?"/>
                    <button name="%(action_to_draft)d" type="action" string="Volver a borrador"
                            invisible="x_state not in ('scheduled', 'error')"/>
                    <button name="%(action_undo)d" type="action" string="Deshacer"
                            invisible="x_state != 'done'"
                            confirm="Se restaurarán los valores que había antes de este lanzamiento. Si alguien ha cambiado esos mismos campos después, sus cambios se pierden. ¿Deshacer?"/>
                    <field name="x_state" widget="statusbar" statusbar_visible="draft,scheduled,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="x_active"/>
                    <field name="x_active" invisible="1"/>
                    <div class="oe_title">
                        <label for="x_name"/>
                        <h1>
                            <field name="x_name" placeholder="p. ej. Fall · Barcelona · precios y combos"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="x_company_id" options="{'no_create': True}"
                                   readonly="x_state not in ('draft', 'error')"/>
                            <field name="x_scheduled_at" readonly="x_state not in ('draft', 'error')"/>
                        </group>
                        <group>
                            <field name="x_executed_at" invisible="not x_executed_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cambios" name="lines">
                            <field name="x_line_ids" readonly="x_state not in ('draft', 'error')"
                                   context="{'form_view_ref': 'gn_launch_planner.view_launch_line_form'}">
                                <tree>
                                    <field name="x_sequence" widget="handle"/>
                                    <field name="x_operation"/>
                                    <field name="x_summary"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Productos y tiendas" name="targets">
                            <group>
                                <field name="x_product_ids" nolabel="1" colspan="2"
                                       context="{'active_test': False}"
                                       readonly="x_state not in ('draft', 'error')"
                                       domain="['|', ('company_id', '=', False), ('company_id', '=', x_company_id)]">
                                    <tree>
                                        <field name="default_code"/>
                                        <field name="name"/>
                                        <field name="list_price"/>
                                        <field name="available_in_pos"/>
                                        <field name="active" string="Activo"/>
                                    </tree>
                                </field>
                            </group>
                            <group string="Puntos de venta (solo para «Categorías visibles en el punto de venta»)">
                                <field name="x_pos_ids" nolabel="1" colspan="2" widget="many2many_tags"
                                       options="{'no_create': True}"
                                       readonly="x_state not in ('draft', 'error')"
                                       domain="[('company_id', '=', x_company_id)]"/>
                            </group>
                        </page>
                        <page string="Resultado" name="result" invisible="not x_log">
                            <field name="x_log" nolabel="1"/>
                        </page>
                        <page string="Valores anteriores" name="snapshots" invisible="not x_snapshot_ids">
                            <field name="x_snapshot_ids" nolabel="1">
                                <tree>
                                    <field name="x_kind"/>
                                    <field name="x_record_name"/>
                                    <field name="x_field"/>
                                    <field name="x_lang" optional="hide"/>
                                    <field name="x_old_float" optional="show"/>
                                    <field name="x_old_bool" optional="show"/>
                                    <field name="x_old_text" optional="show"/>
                                    <field name="x_old_ids" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_launch_tree" model="ir.ui.view">
        <field name="name">x_gn_launch.tree</field>
        <field name="model">x_gn_launch</field>
        <field name="arch" type="xml">
            <tree string="Lanzamientos"
                  decoration-info="x_state == 'scheduled'"
                  decoration-danger="x_state == 'error'"
                  decoration-muted="x_state in ('draft', 'undone')">
                <field name="x_scheduled_at"/>
                <field name="x_name"/>
                <field name="x_company_id" options="{'no_create': True}"/>
                <field name="x_state" widget="badge"
                       decoration-info="x_state == 'scheduled'"
                       decoration-success="x_state == 'done'"
                       decoration-danger="x_state == 'error'"/>
                <field name="x_executed_at" optional="show"/>
                <field name="create_uid" optional="hide" string="Creado por"/>
            </tree>
        </field>
    </record>

    <record id="view_launch_calendar" model="ir.ui.view">
        <field name="name">x_gn_launch.calendar</field>
        <field name="model">x_gn_launch</field>
        <field name="arch" type="xml">
            <calendar string="Lanzamientos" date_start="x_scheduled_at" color="x_company_id"
                      mode="week" quick_create="0" event_open_popup="0">
                <field name="x_name"/>
                <field name="x_state"/>
            </calendar>
        </field>
    </record>

    <record id="view_launch_search" model="ir.ui.view">
        <field name="name">x_gn_launch.search</field>
        <field name="model">x_gn_launch</field>
        <field name="arch" type="xml">
            <search string="Lanzamientos">
                <field name="x_name"/>
                <field name="x_product_ids"/>
                <field name="x_company_id"/>
                <filter name="draft" string="Borradores" domain="[('x_state', '=', 'draft')]"/>
                <filter name="scheduled" string="Programados" domain="[('x_state', '=', 'scheduled')]"/>
                <filter name="done" string="Hechos" domain="[('x_state', '=', 'done')]"/>
                <filter name="error" string="Con error" domain="[('x_state', '=', 'error')]"/>
                <separator/>
                <filter name="archived" string="Archivados" domain="[('x_active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'x_state'}"/>
                    <filter name="group_company" string="Compañía" context="{'group_by': 'x_company_id'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'x_scheduled_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_launches" model="ir.actions.act_window">
        <field name="name">Lanzamientos programados</field>
        <field name="res_model">x_gn_launch</field>
        <field name="view_mode">tree,calendar,form</field>
        <field name="search_view_id" ref="view_launch_search"/>
        <field name="context">{'default_x_company_id': allowed_company_ids[0]}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Programa tu primer lanzamiento</p>
            <p>Elige productos o tiendas, añade los cambios (precio, TPV, combos, tarifas, nombre…)
               y la fecha y hora. Odoo los aplica solo, y si algo falla no se aplica nada.</p>
        </field>
    </record>

    <menuitem id="menu_launches"
              name="Lanzamientos programados"
              parent="point_of_sale.pos_config_menu_catalog"
              action="action_launches"
              sequence="60"/>
</odoo>
