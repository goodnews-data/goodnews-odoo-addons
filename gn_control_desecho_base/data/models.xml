        <record id="field_x_control_de_desecho__x_studio_scrap" model="ir.model.fields">
            <field name="name">x_studio_scrap</field>
            <field name="model_id" ref="model_x_control_de_desecho"/>
            <field name="field_description">Scrap</field>
            <field name="ttype">many2many</field>
            <field name="state">manual</field>
            <field name="relation">stock.scrap</field>
            <field name="relation_table">x_stock_scrap_x_control_de_desecho_rel</field>
            <field name="column1">x_control_de_desecho_id</field>
            <field name="column2">stock_scrap_id</field>
            <field name="depends">x_studio_product_product</field>
            <field name="required" eval="False"/>
            <field name="readonly" eval="True"/>
            <field name="index" eval="False"/>
            <field name="copied" eval="False"/>
            <field name="store" eval="True"/>
            <field name="translate" eval="False"/>
            <field name="sanitize" eval="False"/>
            <field name="group_expand" eval="False"/>
            <field name="compute"><![CDATA[for record in self:
    scrap_ids = []

    if record.x_studio_product_product:
        scraps = self.env['stock.scrap'].search(
            [
                ('product_id', '=', record.x_studio_product_product.id)
            ],
            order='create_date desc',
            limit=30
        )

        scrap_ids = scraps.ids

    record['x_studio_scrap'] = [(6, 0, scrap_ids)]]]></field>
        </record>

        <!-- Orden de la lista (después de crear sus campos) -->
        <record id="model_x_control_de_desecho" model="ir.model">
            <field name="order">x_studio_sequence asc, id asc</field>
        </record>
