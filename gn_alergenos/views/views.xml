<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_6384" model="ir.ui.view">
            <field name="name">Default list view for x_allergens</field>
            <field name="model">x_allergens</field>
            <field name="type">tree</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><tree>
  <field name="x_studio_sequence" widget="handle"/>
  <field name="x_name"/>
</tree></field>
        </record>

        <record id="view_6385" model="ir.ui.view">
            <field name="name">Default form view for x_allergens</field>
            <field name="model">x_allergens</field>
            <field name="type">form</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><form>
  <header/>
  <sheet string="Allergens">
    <widget name="web_ribbon" text="Archivado" bg_color="text-bg-danger" invisible="x_active"/>
    <field name="x_active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="x_name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_576d2d">
      <group name="studio_group_576d2d_left"/>
      <group name="studio_group_576d2d_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <field name="message_follower_ids"/>
    <field name="message_ids"/>
    <field name="activity_ids"/>
  </div>
</form></field>
        </record>

        <record id="view_6386" model="ir.ui.view">
            <field name="name">Default search view for x_allergens</field>
            <field name="model">x_allergens</field>
            <field name="type">search</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><search>
  <field name="x_name"/>
  <separator/>
  <filter string="Archivado" name="archived_x_allergens" domain="[['x_active', '=', False]]"/>
  <separator/>
</search></field>
        </record>

        <record id="view_6387" model="ir.ui.view">
            <field name="name">Odoo Studio: Default form view for x_allergens customization</field>
            <field name="model">x_allergens</field>
            <field name="inherit_id" ref="view_6385"/>
            <field name="priority" eval="99"/>
            <field name="mode">extension</field>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><data>
  <xpath expr="//group[@name='studio_group_576d2d_left']" position="inside">
    <field name="display_name"/>
  </xpath>
</data></field>
        </record>
</odoo>
