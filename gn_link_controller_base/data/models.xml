        <record id="field_x_link_controller__x_studio_purchase_tax" model="ir.model.fields">
            <field name="name">x_studio_purchase_tax</field>
            <field name="model_id" ref="model_x_link_controller"/>
            <field name="field_description">Purchase tax</field>
            <field name="ttype">many2one</field>
            <field name="state">manual</field>
            <field name="relation">account.tax</field>
            <field name="depends">x_studio_product, x_studio_company</field>
            <field name="on_delete">set null</field>
            <field name="required" eval="False"/>
            <field name="readonly" eval="True"/>
            <field name="index" eval="False"/>
            <field name="copied" eval="False"/>
            <field name="store" eval="True"/>
            <field name="translate" eval="False"/>
            <field name="sanitize" eval="False"/>
            <field name="group_expand" eval="False"/>
            <field name="compute"><![CDATA[for record in self:
    if record.x_studio_product:
        company = record.x_studio_company or self.env.company
        
        taxes = record.x_studio_product.supplier_taxes_id
        filtered_taxes = self.env['account.tax']
        
        for t in taxes:
            if t.type_tax_use == 'purchase' and (not t.company_id or t.company_id == company):
                filtered_taxes |= t
        
        record['x_studio_purchase_tax'] = filtered_taxes
    else:
        record['x_studio_purchase_tax'] = False]]></field>
        </record>

