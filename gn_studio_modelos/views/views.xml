        <record id="view_5120" model="ir.ui.view">
            <field name="name">Default list view for x_bpp_banco_prevsion_d</field>
            <field name="model">x_bpp_banco_prevsion_d</field>
            <field name="type">tree</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><tree>
  <field name="x_studio_sequence" widget="handle"/>
  <field name="x_name"/>
  <field name="x_studio_tag_ids" widget="many2many_tags" options="{'color_field': 'x_color'}"/>
</tree></field>
        </record>

        <record id="view_5121" model="ir.ui.view">
            <field name="name">Default form view for x_bpp_banco_prevsion_d</field>
            <field name="model">x_bpp_banco_prevsion_d</field>
            <field name="type">form</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><form>
  <header/>
  <sheet string="(BPP) - Banco Prevsion de Pago">
    <widget name="web_ribbon" text="Archivado" bg_color="text-bg-danger" invisible="x_active"/>
    <field name="x_active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="x_name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_bc936c">
      <group name="studio_group_bc936c_left">
        <field name="x_studio_tag_ids" widget="many2many_tags" options="{'color_field': 'x_color'}"/>
      </group>
      <group name="studio_group_bc936c_right"/>
    </group>
    <group>
      <field name="x_studio_notes" placeholder="Escriba sus notas aquí..." nolabel="1" colspan="2"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <field name="message_follower_ids"/>
    <field name="message_ids"/>
    <field name="activity_ids"/>
  </div>
</form></field>
        </record>

        <record id="view_5122" model="ir.ui.view">
            <field name="name">Default search view for x_bpp_banco_prevsion_d</field>
            <field name="model">x_bpp_banco_prevsion_d</field>
            <field name="type">search</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><search>
  <field name="x_name"/>
  <field name="x_studio_tag_ids"/>
  <separator/>
  <filter string="Archivado" name="archived_x_bpp_banco_prevsion_d" domain="[['x_active', '=', False]]"/>
  <separator/>
</search></field>
        </record>

