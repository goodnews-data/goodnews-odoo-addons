<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_6225" model="ir.ui.view">
            <field name="name">Default list view for x_control_de_desecho</field>
            <field name="model">x_control_de_desecho</field>
            <field name="type">tree</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><tree>
  <field name="x_studio_sequence" widget="handle"/>
  <field name="x_name"/>
</tree></field>
        </record>

        <record id="view_6226" model="ir.ui.view">
            <field name="name">Default form view for x_control_de_desecho</field>
            <field name="model">x_control_de_desecho</field>
            <field name="type">form</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><form>
  <header/>
  <sheet string="Control de desecho">
    <widget name="web_ribbon" text="Archivado" bg_color="text-bg-danger" invisible="x_active"/>
    <field name="x_active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="x_name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_e90e79">
      <group name="studio_group_e90e79_left"/>
      <group name="studio_group_e90e79_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <field name="message_follower_ids"/>
    <field name="message_ids"/>
    <field name="activity_ids"/>
  </div>
</form></field>
        </record>

        <record id="view_6227" model="ir.ui.view">
            <field name="name">Default search view for x_control_de_desecho</field>
            <field name="model">x_control_de_desecho</field>
            <field name="type">search</field>
            <field name="priority" eval="16"/>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><search>
  <field name="x_name"/>
  <separator/>
  <filter string="Archivado" name="archived_x_control_de_desecho" domain="[['x_active', '=', False]]"/>
  <separator/>
</search></field>
        </record>

        <record id="view_6228" model="ir.ui.view">
            <field name="name">Odoo Studio: Default form view for x_control_de_desecho customization</field>
            <field name="model">x_control_de_desecho</field>
            <field name="inherit_id" ref="view_6226"/>
            <field name="priority" eval="99"/>
            <field name="mode">extension</field>
            <field name="active" eval="True"/>
            <field name="arch" type="xml"><data>
  <xpath expr="//group[@name='studio_group_e90e79_left']" position="inside">
    <field name="x_studio_product_product" options="{&quot;no_create&quot;:true}" required="True"/>
    <field name="x_studio_warehouse" widget="many2many_tags" options="{&quot;no_quick_create&quot;:true,&quot;no_create&quot;:true}" required="True" domain="[(&quot;usage&quot;, &quot;=&quot;, &quot;internal&quot;)]"/>
    <field name="x_studio_frequency"/>
    <field name="x_studio_weekday"/>
  </xpath>
  <xpath expr="//group[@name='studio_group_e90e79_right']" position="inside">
    <field name="x_studio_last_date" force_save="1" readonly="True"/>
    <field name="x_studio_next_date"/>
    <field name="x_studio_company" options="{&quot;no_create&quot;:true}" required="True" domain="[&quot;|&quot;, &quot;|&quot;, &quot;|&quot;, (&quot;id&quot;, &quot;=&quot;, 1), (&quot;id&quot;, &quot;=&quot;, 7), (&quot;id&quot;, &quot;=&quot;, 8), (&quot;id&quot;, &quot;=&quot;, 12)]"/>
    <field name="x_studio_active"/>
  </xpath>
</data></field>
        </record>
</odoo>
