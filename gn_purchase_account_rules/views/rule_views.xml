<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List -->
    <record id="view_x_gn_purchase_account_rule_tree" model="ir.ui.view">
        <field name="name">x_gn_purchase_account_rule.tree</field>
        <field name="model">x_gn_purchase_account_rule</field>
        <field name="arch" type="xml">
            <tree string="Reglas contables de compra">
                <field name="x_name"/>
                <field name="x_partner_id"/>
                <field name="x_product_tmpl_ids" widget="many2many_tags"/>
                <field name="x_account_id"/>
                <field name="x_tax_ids" widget="many2many_tags"/>
                <field name="x_company_id" groups="base.group_multi_company"/>
                <field name="x_active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- Form -->
    <record id="view_x_gn_purchase_account_rule_form" model="ir.ui.view">
        <field name="name">x_gn_purchase_account_rule.form</field>
        <field name="model">x_gn_purchase_account_rule</field>
        <field name="arch" type="xml">
            <form string="Regla contable de compra">
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="x_active"/>
                    <div class="oe_title">
                        <label for="x_name"/>
                        <h1><field name="x_name" placeholder="p. ej. Califrais: vasos a transporte"/></h1>
                    </div>
                    <group>
                        <group string="Cuándo se aplica">
                            <field name="x_company_id" options="{'no_create': True}"/>
                            <field name="x_partner_id" options="{'no_create': True}" domain="[('parent_id', '=', False)]"/>
                            <field name="x_active" invisible="1"/>
                        </group>
                        <group string="Qué se aplica">
                            <field name="x_account_id" options="{'no_create': True}"
                                   domain="[('company_id', '=', x_company_id), ('deprecated', '=', False)]"
                                   placeholder="Vacío = la del producto"/>
                            <field name="x_tax_ids" widget="many2many_tags" options="{'no_create': True}"
                                   domain="[('type_tax_use', '=', 'purchase'), ('company_id', '=', x_company_id)]"
                                   placeholder="Vacío = el del producto"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="products" string="Productos">
                            <field name="x_product_tmpl_ids" options="{'no_create': True}"
                                   domain="['|', ('company_id', '=', False), ('company_id', '=', x_company_id)]">
                                <tree>
                                    <field name="default_code"/>
                                    <field name="name"/>
                                    <field name="categ_id"/>
                                </tree>
                            </field>
                        </page>
                        <page name="notes" string="Notas">
                            <field name="x_notes" placeholder="Motivo de la regla, quién la validó en contabilidad…"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_x_gn_purchase_account_rule_search" model="ir.ui.view">
        <field name="name">x_gn_purchase_account_rule.search</field>
        <field name="model">x_gn_purchase_account_rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_name"/>
                <field name="x_partner_id"/>
                <field name="x_product_tmpl_ids"/>
                <field name="x_account_id"/>
                <filter name="archived" string="Archivadas" domain="[('x_active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_partner" string="Proveedor" context="{'group_by': 'x_partner_id'}"/>
                    <filter name="group_company" string="Compañía" context="{'group_by': 'x_company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action and menu (Accounting > Configuration > Accounting) -->
    <record id="action_x_gn_purchase_account_rule" model="ir.actions.act_window">
        <field name="name">Reglas contables de compra</field>
        <field name="res_model">x_gn_purchase_account_rule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_x_gn_purchase_account_rule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea una regla contable de compra</p>
            <p>Define qué cuenta de gasto e IVA de compra usar cuando un proveedor factura ciertos productos.</p>
        </field>
    </record>

    <menuitem id="menu_x_gn_purchase_account_rule"
              name="Reglas contables de compra"
              parent="account.account_account_menu"
              action="action_x_gn_purchase_account_rule"
              groups="account.group_account_manager"
              sequence="6"/>
</odoo>
